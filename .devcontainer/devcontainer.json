{
  "name": "Haisai",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5173, 3000, 5555],
  "portsAttributes": {
    "5173": { "label": "Vite", "onAutoForward": "notify" },
    "3000": { "label": "vercel dev", "onAutoForward": "notify" },
    "5555": { "label": "Prisma Studio", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mikestead.dotenv",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[prisma]": {
          "editor.defaultFormatter": "Prisma.prisma"
        }
      }
    }
  },
  "postCreateCommand": "npm install -g vercel && if [ -f package.json ]; then npm install; fi",
  "remoteUser": "node"
}
